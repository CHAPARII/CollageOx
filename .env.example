NODE_ENV=development
OWNER_USERNAME=change-me
OWNER_INITIAL_PASSWORD=change-this-initial-password
OWNER_EMAIL=owner@example.edu
OWNER_NAME=Campus Owner
# Optional comma-separated campus domains. Leave blank to allow any valid email domain.
# CAMPUS_EMAIL_DOMAINS=college.edu,students.college.edu
# Local development uses SQLite when DATABASE_URL is omitted.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Optional Web Push. Leave unset to keep in-app notifications only.
# VAPID_PUBLIC_KEY=base64url-p256-public-key
# VAPID_PRIVATE_KEY=base64url-p256-private-key
# VAPID_SUBJECT=mailto:admin@example.edu
